{
  "name": "combinatorial-forge-web",
  "version": "0.2.0",
  "private": true,
  "description": "Combinatorial Forge web application: explorer, distributed compute and verification API.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/sync-results.mjs && node scripts/gen-migrations.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/sync-results.mjs && node scripts/gen-migrations.mjs && vitest run",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "e2e": "playwright test",
    "snapshot": "node --experimental-strip-types scripts/snapshot.ts",
    "seed:run": "node --experimental-strip-types scripts/seed-run.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  }
}
