# Copy to .env.local for development. Never commit real values.

# --- Database (server-side only; never exposed to the browser) -------------------------------
# Turso/libSQL: create with `turso db create` then `turso db tokens create`.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=
# Local development fallback when TURSO_DATABASE_URL is unset: file:./.data/forge-dev.db

# --- Administration --------------------------------------------------------------------------
# Bearer token for /api/v1/admin/*. Must be at least 24 characters; admin routes are disabled otherwise.
# Generate one with: openssl rand -base64 32
ADMIN_TOKEN=

# --- Anti-abuse (optional) -------------------------------------------------------------------
# Salt for hashing client networks (HMAC). Defaults to ADMIN_TOKEN. Raw IP addresses are never stored.
FORGE_NETWORK_SALT=
# Require matching submissions to come from distinct networks. Defaults to true in production.
FORGE_REQUIRE_DISTINCT_NETWORKS=
# Public site URL used in manifests and links (defaults to the Vercel deployment URL).
NEXT_PUBLIC_SITE_URL=
